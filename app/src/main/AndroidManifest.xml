        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".DebugPackagesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <receiver
            android:name=".services.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".BroadcastSnifferActivity"
            android:label="Sniffer"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <activity android:name=".VolumeActivity" />

        <activity
            android:name=".SystemExplorerActivity"
            android:label="System Explorer"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <service
            android:name=".services.ServicioNotificaciones"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service android:name=".managers.VolumeManagerService" />


    </application>
</manifest>