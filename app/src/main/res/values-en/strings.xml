    <!-- ══════════ Welcome tour ══════════ -->
    <string name="tour_shortcuts_titulo">Shortcuts</string>
    <string name="tour_shortcuts_desc">Tap to open the assigned app. Long press to change which app shows in each shortcut.</string>
    <string name="tour_apps_titulo">All apps</string>
    <string name="tour_apps_desc">Browse and open any app installed on the head unit. Long press here to see this tour again.</string>
    <string name="tour_reloj_titulo">Clock</string>
    <string name="tour_reloj_desc">Tap to go to the lock screen. Long press to open the date and time settings.</string>
    <string name="tour_velocimetro_titulo">GPS Speedometer</string>
    <string name="tour_velocimetro_desc">Shows your current speed in km/h using the device GPS. Requires location permission.</string>
    <string name="tour_marcha_titulo">Gear indicator</string>
    <string name="tour_marcha_desc">Shows the estimated gear based on your speed. Tap to configure the speed ranges for each gear.</string>
    <string name="tour_reproductor_titulo">Audio player</string>
    <string name="tour_reproductor_desc">Control music, radio or any audio without leaving the launcher. Long press to enable the dynamic background color.</string>
    <string name="tour_wifi_titulo">WiFi status</string>
    <string name="tour_wifi_desc">Shows the connected WiFi network in real time. Tap to open network settings.</string>
    <string name="tour_bluetooth_titulo">Bluetooth</string>
    <string name="tour_bluetooth_desc">Shows the paired device. Tap to open Bluetooth settings.</string>
    <string name="tour_bloqueo_titulo">Lock &amp; Kiosk Mode</string>
    <string name="tour_bloqueo_desc">Tap to lock the screen. Long press to enable Kiosk Mode — the launcher will return automatically after 30 s in another app.</string>
