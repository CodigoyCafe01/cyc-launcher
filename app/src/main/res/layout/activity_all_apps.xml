<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A2E"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/tv_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/lbl_todas_apps"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

    </RelativeLayout>

    <!-- Tabs: Todas / Sistema -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/header"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_todas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/tab_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_todas"
            android:textColor="@color/tab_text_color"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tab_sistema"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/tab_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_sistema"
            android:textColor="@color/tab_text_color"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/tabs_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/tabs"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/tv_cargando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tabs_divider"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/lbl_cargando_apps"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Apps Grid -->
    <GridView
        android:id="@+id/apps_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabs_divider"
        android:layout_marginTop="12dp"
        android:numColumns="6"
        android:verticalSpacing="12dp"
        android:horizontalSpacing="12dp"
        android:gravity="center"
        android:stretchMode="columnWidth" />

</RelativeLayout>
