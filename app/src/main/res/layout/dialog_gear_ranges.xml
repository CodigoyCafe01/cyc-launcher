<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialogo_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gear_titulo"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gear_subtitulo"
            android:textColor="#7A7FA8"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <!-- Selector de motor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gear_tipo_motor"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_motor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/system_item_bg"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- 1ª → 2ª -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gear_1_2"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/input_corte_1"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:singleLine="true"
                android:inputType="number"
                android:maxLength="3"
                android:background="@drawable/system_item_bg"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_kmh"
                android:textColor="#7A7FA8"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 2ª → 3ª -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gear_2_3"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/input_corte_2"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:singleLine="true"
                android:inputType="number"
                android:maxLength="3"
                android:background="@drawable/system_item_bg"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_kmh"
                android:textColor="#7A7FA8"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 3ª → 4ª -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gear_3_4"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/input_corte_3"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:singleLine="true"
                android:inputType="number"
                android:maxLength="3"
                android:background="@drawable/system_item_bg"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_kmh"
                android:textColor="#7A7FA8"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 4ª → 5ª -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gear_4_5"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/input_corte_4"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:singleLine="true"
                android:inputType="number"
                android:maxLength="3"
                android:background="@drawable/system_item_bg"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_kmh"
                android:textColor="#7A7FA8"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Restablecer preset -->
        <TextView
            android:id="@+id/boton_restablecer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gear_restablecer_motor"
            android:textColor="#2979FF"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/system_item_bg"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="14dp" />

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="22dp">

            <TextView
                android:id="@+id/boton_cancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancelar"
                android:textColor="#B0B0B0"
                android:textSize="14sp"
                android:padding="12dp" />

            <TextView
                android:id="@+id/boton_guardar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_guardar"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/boton_agregar_bg"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="20dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
