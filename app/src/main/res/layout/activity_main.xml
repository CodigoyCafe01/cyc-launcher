<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Barra superior -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btn_theme_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_lock"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/badge_permisos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shortcut_bg"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_dialog_alert" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permisos"
                    android:textColor="#FFC107"
                    android:textSize="11sp"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/indicador_wifi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shortcut_bg"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icono_wifi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_wifi_off" />

                <TextView
                    android:id="@+id/texto_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin WiFi"
                    android:textColor="#B0B0B0"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="100dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/indicador_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shortcut_bg"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icono_bluetooth"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bt_off" />

                <TextView
                    android:id="@+id/texto_bluetooth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BT Off"
                    android:textColor="#B0B0B0"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="120dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boton_contactos"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/shortcut_bg"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_myplaces" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════
             Sección central: Velocímetro + Reloj + Reproductor

             Truco de simetría: hay un "espejo" invisible del lado
             opuesto a cada widget lateral con el mismo peso.
             El reloj (weight=2) siempre queda centrado sin importar
             cuáles laterales están VISIBLE o GONE.

             [espejo-der 0.9] [speed 0.9] [reloj 2] [reproductor 0.9] [espejo-izq 0.9]
             ═══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <!-- Espejo invisible del reproductor (opuesto derecho→izquierdo)
                 Cuando reproductor=VISIBLE este espejo=VISIBLE para balancear -->
            <View
                android:id="@+id/espejo_izquierdo"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.9"
                android:visibility="gone" />

            <!-- ── Velocímetro ── -->
            <LinearLayout
                android:id="@+id/speed_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/speed_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="56sp"
                    android:fontFamily="sans-serif-thin"
                    android:lineSpacingMultiplier="0.9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#5A6080"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="-4dp" />

                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:background="#1E2140"
                    android:clipChildren="true">
                    <View
                        android:id="@+id/speed_bar"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:background="#4A50D0"
                        android:layout_weight="0" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Reloj — peso fijo, siempre centrado ── -->
            <LinearLayout
                android:id="@+id/clock_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/boton_reloj"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clock_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-thin"
                        android:text="12:00"
                        android:textColor="#FFFFFFFF"
                        android:textSize="72sp" />

                    <TextView
                        android:id="@+id/date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Lun, 1 Ene 2026"
                        android:textColor="#B0B0B0"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Reproductor ── -->
            <LinearLayout
                android:id="@+id/widget_reproductor"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/shortcut_bg"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/reproductor_icono"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_music"
                        android:scaleType="centerCrop"
                        android:background="@drawable/shortcut_bg"
                        android:padding="6dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:id="@+id/reproductor_titulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/reproductor_artista"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#7A7FA8"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E2140"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/btn_anterior"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_anterior"
                        android:padding="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btn_play_pausa"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_play"
                        android:padding="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/shortcut_bg_accent"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="2dp" />

                    <ImageView
                        android:id="@+id/btn_siguiente"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_siguiente"
                        android:padding="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Espejo invisible del velocímetro (opuesto izquierdo→derecho)
                 Cuando speed=VISIBLE este espejo=VISIBLE para balancear -->
            <View
                android:id="@+id/espejo_derecho"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.9"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Shortcuts -->
        <LinearLayout
            android:id="@+id/shortcuts_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center|top"
            android:orientation="horizontal"
            android:paddingTop="5dp">

            <LinearLayout
                android:id="@+id/shortcut_0"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:background="@drawable/shortcut_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/shortcut_icon_0"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_shortcut" />

                <TextView
                    android:id="@+id/shortcut_name_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Música"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_1"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:background="@drawable/shortcut_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/shortcut_icon_1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_shortcut" />

                <TextView
                    android:id="@+id/shortcut_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Navegación"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_2"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:background="@drawable/shortcut_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/shortcut_icon_2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_shortcut" />

                <TextView
                    android:id="@+id/shortcut_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Teléfono"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_3"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:background="@drawable/shortcut_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/shortcut_icon_3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_shortcut" />

                <TextView
                    android:id="@+id/shortcut_name_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Radio"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_4"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:background="@drawable/shortcut_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/shortcut_icon_4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_shortcut" />

                <TextView
                    android:id="@+id/shortcut_name_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Config."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_all_apps"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="8dp"
                android:background="@drawable/shortcut_bg_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/all_apps_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_all_apps" />

                <TextView
                    android:id="@+id/all_apps_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Apps"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Panel de sistema (oculto por defecto) -->
    <LinearLayout
        android:id="@+id/system_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/system_panel_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone" />

</FrameLayout>