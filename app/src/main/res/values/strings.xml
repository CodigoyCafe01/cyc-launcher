    <string name="tour_shortcuts_titulo">Accesos directos</string>
    <string name="tour_shortcuts_desc">Toca para abrir la app asignada. Mantén presionado para cambiar qué app aparece en cada acceso directo.</string>
    <string name="tour_apps_titulo">Todas las apps</string>
    <string name="tour_apps_desc">Explora y abre cualquier app instalada en el headunit. Mantén presionado aquí para volver a ver este tour.</string>
    <string name="tour_reloj_titulo">Reloj</string>
    <string name="tour_reloj_desc">Toca para ir a la pantalla de bloqueo. Mantén presionado para abrir los ajustes de fecha y hora.</string>
    <string name="tour_velocimetro_titulo">Velocímetro GPS</string>
    <string name="tour_velocimetro_desc">Muestra tu velocidad actual en km/h usando el GPS del dispositivo. Requiere permiso de ubicación.</string>
    <string name="tour_marcha_titulo">Indicador de marcha</string>
    <string name="tour_marcha_desc">Muestra la marcha estimada según tu velocidad. Toca para configurar los rangos de velocidad de cada marcha.</string>
    <string name="tour_reproductor_titulo">Reproductor de audio</string>
    <string name="tour_reproductor_desc">Controla música, radio o cualquier audio sin salir del launcher. Mantén presionado para activar el color dinámico de fondo.</string>
    <string name="tour_wifi_titulo">Estado WiFi</string>
    <string name="tour_wifi_desc">Muestra la red WiFi conectada en tiempo real. Toca para abrir la configuración de red.</string>
    <string name="tour_bluetooth_titulo">Bluetooth</string>
    <string name="tour_bluetooth_desc">Muestra el dispositivo vinculado. Toca para abrir la configuración de Bluetooth.</string>
    <string name="tour_bloqueo_titulo">Bloqueo y Modo Kiosk</string>
    <string name="tour_bloqueo_desc">Toca para bloquear la pantalla. Mantén presionado para activar el Modo Kiosk — el launcher regresará automáticamente tras 30 s en otra app.</string>
